# ─────────────────────────────────────────────────────────────────────────────
# Spyvoo environment variables. Copy to .env for local runs; on Railway paste
# them into the service's "Variables" tab (Raw Editor accepts this whole file).
# Only the REQUIRED block is needed to launch. Everything else switches a feature on.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
NODE_ENV=production
# Your public address, no trailing slash. Used in emails, webhooks and SEO.
APP_URL=https://spyvoo.com
# Long random string (openssl rand -hex 32). Signs sessions and encrypts saved tokens. Never change it after launch.
APP_SECRET= 
# The first admin is created on the first boot from these two. Change the password after you log in.
ADMIN_EMAIL=you@spyvoo.com
ADMIN_PASSWORD=
# Keep the database on the Railway volume mounted at /app/data.
DATABASE_PATH=/app/data/spyvoo.db

# ── AD DATA (Meta Ad Library through Apify) ─────────────────────────────────
# console.apify.com → Settings → Integrations → API token. Can also be saved later in Admin → Ad data & AI.
APIFY_TOKEN=
# Actor that scrapes the Meta Ad Library. Default is the official one.
APIFY_ACTOR=apify~facebook-ads-scraper
# APIFY_API_URL=https://api.apify.com/v2
# Fill an empty database with sample ads so the dashboard is never empty (remove them later in Admin → Ads manager).
DEMO_ADS=true

# ── AI (Claude) ─────────────────────────────────────────────────────────────
# console.anthropic.com → API keys. Without it, simple rule-based breakdowns are used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# Optional: read what video ads say (OpenAI Whisper).
TRANSCRIBE_API_KEY=
# TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1

# ── MEDIA STORAGE (keep ad images/videos forever) ──────────────────────────
# Use r2 in production: every ad video is stored in Cloudflare R2 and streamed to users from media.spyvoo.com
# with zero egress fees (Railway charges for every GB served). local = files on the Railway volume (dev only).
MEDIA_DRIVER=r2
# MEDIA_DIR=/app/data/media
# R2_ACCOUNT_ID=
# Optional: custom S3 endpoint (default https://<account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# R2_BUCKET=spyvoo-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public bucket URL or custom domain, e.g. https://media.spyvoo.com
# R2_PUBLIC_URL=

# ── EMAIL ───────────────────────────────────────────────────────────────────
# resend | brevo | postmark | log (log = print to the console, nothing is sent)
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=Spyvoo <hello@spyvoo.com>
MAIL_REPLY_TO=support@spyvoo.com

# ── PAYMENTS (Gatevoo crypto checkout) ──────────────────────────────────────
GATEVOO_API_KEY=
GATEVOO_WEBHOOK_SECRET=
# GATEVOO_API_URL=https://api.gatevoo.com/v1
# Test checkout without real money. MUST be false in production.
PAYMENTS_DEMO=false

# ── VOOSQUARE (one login for every Voo tool, optional) ─────────────────────
# Login switches to "Continue with VooSquare" when VOO_ISSUER and VOO_CLIENT_ID are set.
VOO_ISSUER=
VOO_CLIENT_ID=
VOO_CLIENT_SECRET=
# VOO_REDIRECT_URI=https://spyvoo.com/auth/voosquare/callback
VOO_SERVICE_KEY=
VOO_WEBHOOK_SECRET=
# VOO_EVENTS_URL=https://api.voosquare.com/v1/events
# VOO_HOME_URL=https://voosquare.com

# ── ADVANCED ────────────────────────────────────────────────────────────────
# Railway sets PORT for you.
# PORT=3000
# Behind Railway's proxy: keep true so rate limits see real visitor IPs.
TRUST_PROXY=true
# Background jobs (scraping, media, alerts, renewals). Keep true on exactly one instance.
SCHEDULER=true
# Seed plans/admin/sample ads on a brand-new database.
AUTO_SEED=true
# Railway sets these for you: RAILWAY_PUBLIC_DOMAIN (used as APP_URL until you set one), RAILWAY_VOLUME_MOUNT_PATH.
