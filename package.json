    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js",
    "e2e:gatevoo": "node scripts/e2e-gatevoo.js . ../gatevoo-main",
    "tour-voice": "node scripts/tour-voice.js"
  },
