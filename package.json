{
  "name": "spyvoo",
  "version": "1.0.0",
  "private": true,
  "description": "Spyvoo by Zedapex: spy on winning Facebook and Instagram ads. Website, dashboard, admin panel, data pipeline and API in one zero-dependency Node.js app.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
